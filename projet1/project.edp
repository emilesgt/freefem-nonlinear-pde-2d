load "medit"
load "iovtk"
int[int] fforder2 =[1,1,1,1];

// Les donnees
func Uex = sin(pi*x)*sin(pi*y);
func DxUex = pi*cos(pi*x)*sin(pi*y);
func DyUex = pi*sin(pi*x)*cos(pi*y);
func f  = 2.*pi*pi*sin(pi*x)*sin(pi*y);

func lambda  =1.;


int meshsize = 10;
mesh Th = square(meshsize,meshsize);

fespace Vh(Th,P2);
Vh u,v;

real ErreurL2 ;
real ErreurH1 ;

//Etape 1

real[int] Hvalues = [10, 20, 40, 80, 120];
real[int] ErreursL2(5);
real[int] ErreursH1(5);


for(int k = 0; k < Hvalues.n; k++){
    int i = Hvalues[k];
    Th = square(i, i);    
      
    solve Etape1(u, v) =
            int2d(Th)( lambda * ( dx(u)*dx(v) + dy(u)*dy(v)))
            - int2d(Th)(f*v)
            + on(1,2,3,4, u=Uex);

    plot(u, wait=true, fill=true, dim = 3, value=true, cmm = "Solution u pour h = " + i);

    ErreurL2 = sqrt(int2d(Th) ((Uex-u)*(Uex-u))); // en L²
    cout << "Erreur L2 =====    "<<ErreurL2<< endl;
    ErreursL2[k]=ErreurL2;

    ErreurH1 = sqrt(int2d(Th)((Uex-u)*(Uex-u) + (DxUex - dx(u))^2 + (DyUex - dy(u))^2)); // en H1
    cout << "Erreur H1 =====    "<<ErreurH1<< endl;
    ErreursH1[k]=ErreurH1;
}
real[int] logH(Hvalues.n), logErrL2(Hvalues.n), logErrH1(Hvalues.n);
for(int k=0; k<Hvalues.n; k++){
    logH[k] = log(1.0/Hvalues[k]); // log(h) ou h = 1/N
    logErrL2[k] = log(ErreursL2[k]);
    logErrH1[k] = log(ErreursH1[k]);
}
plot([logH, logErrL2], wait=1, cmm="Convergence L2 Log-Log");
plot([logH, logErrH1], wait=1, cmm="Convergence H1 Log-Log");

// --- Calcul précis des ordres de convergence ---
int last = Hvalues.n - 1;

// Calcul des pas de maillage h (approx 1/N)
real hFinal = 1.0 / Hvalues[last];
real hAvant = 1.0 / Hvalues[last-1];

// Formule de la pente : (log(E2) - log(E1)) / (log(h2) - log(h1))
real PenteL2 = (log(ErreursL2[last]) - log(ErreursL2[last-1])) 
             / (log(hFinal) - log(hAvant));

real PenteH1 = (log(ErreursH1[last]) - log(ErreursH1[last-1])) 
             / (log(hFinal) - log(hAvant));

cout << "------------------------------------------------" << endl;
cout << "VERIFICATION DES ORDRES DE CONVERGENCE (P2)" << endl;
cout << "Ordre theorique L2 : 3.00  |  Obtenu : " << PenteL2 << endl;
cout << "Ordre theorique H1 : 2.00  |  Obtenu : " << PenteH1 << endl;
cout << "------------------------------------------------" << endl;


// --- Etape 2 et 3 :
meshsize = 10;
Th = square(meshsize, meshsize);

real[int] pValues = [2., 3., 5., 10.];
int NPF = 1000; // Nombre max d'iterations
real tol = 1e-6; // Tolerance pour la condition d'arret
real Epsilon = 1e-3;


// --- MACROS POUR SIMPLIFIER L'ÉCRITURE ---
// Produit scalaire de deux gradients : Grad(w1) . Grad(w2)
macro gradDot(w1, w2) ( dx(w1)*dx(w2) + dy(w1)*dy(w2) ) //
// Norme du gradient au carre : |Grad(w)|^2
macro gradSq(w)       ( dx(w)*dx(w) + dy(w)*dy(w) ) //

// Coefficients de Newton a(uk) et b(uk)
macro a(uk, pVal) ( (Epsilon + gradSq(uk))^((pVal - 2.)/2.) ) //
macro b(uk, pVal) ( (pVal - 2.) * (Epsilon + gradSq(uk))^((pVal - 4.)/2.) ) //


Vh uInit, vInit;
solve Initialisation(uInit, vInit) =
            int2d(Th)( lambda * ( dx(uInit)*dx(vInit) + dy(uInit)*dy(vInit)))
            - int2d(Th)(f*vInit)
            + on(1,2,3,4, uInit=0);

Vh uk = uInit;
// Resolution non lineaire (Picard) ---
for(int k = 0; k < pValues.n; k++){
    real p = pValues[k];
    cout << "\n==========================================" << endl;
    cout << "  Resolution pour p = " << p << endl;
    cout << "==========================================" << endl;
    
     // Initialisation : u_0 = 0
    real Erreur = 1.0;
    
    for(int i = 0; i < NPF; i++) {        
        solve Picard(u, v) =
            // Terme de diffusion a(uk) * Grad(u).Grad(v)
            int2d(Th)( a(uk, p) * (dx(u)*dx(v) + dy(u)*dy(v)) )
            // Terme source f*v
          - int2d(Th)( f * v )
            // Conditions de Dirichlet homogenes sur tout le bord
          + on(1, 2, 3, 4, u = 0);

        // Calcul de l'erreur entre la nouvelle solution u et l'ancienne uk
        Erreur = sqrt(int2d(Th)( (u - uk)^2 ));
        
        // Mise a jour : u devient uk pour la prochaine iteration
        uk = u; 
        
        if (i % 5 == 0) { // Affiche l'erreur toutes les 5 iterations
            cout << "Iteration " << i << " | Erreur L2 = " << Erreur << endl;
        }

        // Critere d'arret
        if (Erreur < tol) {
            cout << "--> Convergence atteinte a l'iteration " << i << endl;
            break; 
        }
    }
    
    // 2. Tracer la solution u et la norme du gradient
    plot(u, wait=true, fill=true,dim = 3, value=true, cmm="Solution u pour p = " + p);
    
    // Calcul de la norme du gradient (projetee sur Vh pour l'affichage)
    Vh normGrad = sqrt(dx(u)*dx(u) + dy(u)*dy(u));
    plot(normGrad, wait=true, fill=true, dim = 3, value=true, cmm="Norme du gradient pour p = " + p);
}

// Resolution non lineaire (NEWTON) 

int NiterMax = 50;  // Newton converge très vite, pas besoin de 1000

for(int k = 0; k < pValues.n; k++){
    real p = pValues[k];
    cout << "\n==========================================" << endl;
    cout << "  Methode de NEWTON pour p = " << p << endl;
    cout << "==========================================" << endl;
    
    real Erreur = 1.0;
    
    for(int i = 0; i < NiterMax; i++) {
        
        solve Newton(u, v) =
            // -- PARTIE GAUCHE (Bilineaire en u et v) --
            // Terme classique (a(uk) * Grad(u).Grad(v))
            int2d(Th)( a(uk, p) * gradDot(u, v) )
            // Terme derive (b(uk) * (Grad(uk).Grad(u)) * (Grad(uk).Grad(v)))
          + int2d(Th)( b(uk, p) * gradDot(uk, u) * gradDot(uk, v) )
          
            // -- PARTIE DROITE (Lineaire en v) --
            // Terme source
          - int2d(Th)( f * v )
            // Reste de la linearisation : b(uk) * |Grad(uk)|^2 * (Grad(uk).Grad(v))
          - int2d(Th)( b(uk, p) * gradSq(uk) * gradDot(uk, v) )
          
            // Conditions de Dirichlet
          + on(1, 2, 3, 4, u = 0);

        // Calcul de l'erreur L2
        Erreur = sqrt(int2d(Th)( (u - uk)^2 ));
        uk = u; // Mise a jour
        
        cout << "Iteration " << i << " | Erreur L2 = " << Erreur << endl;

        // Critere d'arret
        if (Erreur < tol) {
            cout << "--> Convergence de Newton atteinte en " << i << " iterations !" << endl;
            break; 
        }
    }
    
    plot(u, wait=true, fill=true, dim = 3, value=true, cmm="Solution u pour p = " + p);

    // Calcul de la norme du gradient (projetee sur Vh pour l'affichage)
    Vh normGrad = sqrt(dx(u)*dx(u) + dy(u)*dy(u));
    plot(normGrad, wait=true, fill=true, value=true, cmm="Norme du gradient pour p = " + p);
}


// ====================================================================
// ETAPE 4 : ETUDE PARAMETRIQUE
// ====================================================================
cout << "\n\n*************************************************" << endl;
cout << "****** DEBUT DE L'ETUDE PARAMETRIQUE ************" << endl;
cout << "*************************************************" << endl;


// Redéfinition des macros pour inclure Epsilon comme variable
macro aEps(uk, pVal, eps) ( (eps + gradSq(uk))^((pVal - 2.)/2.) ) //
macro bEps(uk, pVal, eps) ( (pVal - 2.) * (eps + gradSq(uk))^((pVal - 4.)/2.) ) //

// -----------------------------------------------------------------
// ETUDE 1 : INFLUENCE DE p (On fixe N=40 et Epsilon=1e-5)
// -----------------------------------------------------------------
cout << "\n1. INFLUENCE DE p (N=40, Epsilon=1e-5)" << endl;
cout << "p \t| Iterations \t| Max(u)" << endl;
cout << "----------------------------------------" << endl;

int NFixe = 40;
real epsFixe = 1e-5;
real[int] testP = [2., 3., 5., 8., 10.];

mesh ThParam = square(NFixe, NFixe);
fespace VhParam(ThParam, P1); // P1 est suffisant et rapide pour cette etude
VhParam uP, vP, ukP, uInitP;

// Initialisation avec p=2
solve InitParam(uInitP, vP) = int2d(ThParam)( gradDot(uInitP, vP) ) - int2d(ThParam)( f * vP ) + on(1,2,3,4, uInitP=0);
ukP = uInitP;

for(int k = 0; k < testP.n; k++) {
    real pActuel = testP[k];
    int iter = 0;
    for(iter = 0; iter < NiterMax; iter++) {
        solve NewtonP(uP, vP) =
            int2d(ThParam)( aEps(ukP, pActuel, epsFixe) * gradDot(uP, vP) )
          + int2d(ThParam)( bEps(ukP, pActuel, epsFixe) * gradDot(ukP, uP) * gradDot(ukP, vP) )
          - int2d(ThParam)( f * vP )
          - int2d(ThParam)( bEps(ukP, pActuel, epsFixe) * gradSq(ukP) * gradDot(ukP, vP) )
          + on(1, 2, 3, 4, uP = 0);

        if (sqrt(int2d(ThParam)( (uP - ukP)^2 )) < tol) break;
        ukP = uP; // Continuation
    }
    cout << pActuel << " \t| " << iter << " \t\t| " << uP[].max << endl;
}

// -----------------------------------------------------------------
// ETUDE 2 : INFLUENCE DE EPSILON (On fixe p=5 et N=40)
// -----------------------------------------------------------------
cout << "\n2. INFLUENCE DE Epsilon (p=5, N=40)" << endl;
cout << "Epsilon \t| Iterations \t| Max(u)" << endl;
cout << "----------------------------------------" << endl;

real pFixe = 5.0;
real[int] testEps = [1e-1, 1e-3, 1e-6, 1e-9];
ukP = uInitP; // On repart du Laplacien pour que ce soit juste

for(int k = 0; k < testEps.n; k++) {
    real epsActuel = testEps[k];
    int iter = 0;
    ukP = uInitP; // Reinitialisation pour chaque test
    
    for(iter = 0; iter < NiterMax; iter++) {
        solve NewtonEps(uP, vP) =
            int2d(ThParam)( aEps(ukP, pFixe, epsActuel) * gradDot(uP, vP) )
          + int2d(ThParam)( bEps(ukP, pFixe, epsActuel) * gradDot(ukP, uP) * gradDot(ukP, vP) )
          - int2d(ThParam)( f * vP )
          - int2d(ThParam)( bEps(ukP, pFixe, epsActuel) * gradSq(ukP) * gradDot(ukP, vP) )
          + on(1, 2, 3, 4, uP = 0);

        if (sqrt(int2d(ThParam)( (uP - ukP)^2 )) < tol) break;
        ukP = uP;
    }
    cout << epsActuel << " \t| " << iter << " \t\t| " << uP[].max << endl;
}

// -----------------------------------------------------------------
// ETUDE 3 : INFLUENCE DU MAILLAGE (On fixe p=5 et Epsilon=1e-5)
// -----------------------------------------------------------------
cout << "\n3. INFLUENCE DU MAILLAGE (p=5, Epsilon=1e-5)" << endl;
cout << "N \t| Iterations \t| Max(u)" << endl;
cout << "----------------------------------------" << endl;

int[int] testN = [10, 20, 40, 80];

for(int k = 0; k < testN.n; k++) {
    int NActuel = testN[k];
    mesh ThN = square(NActuel, NActuel); // Creation du nouveau maillage
    fespace VhN(ThN, P1); 
    VhN uN, vN, ukN, uInitN;
    
    // Initialisation sur le NOUVEAU maillage
    solve InitN(uInitN, vN) = int2d(ThN)( gradDot(uInitN, vN) ) - int2d(ThN)( f * vN ) + on(1,2,3,4, uInitN=0);
    ukN = uInitN;
    
    int iter = 0;
    for(iter = 0; iter < NiterMax; iter++) {
        solve NewtonN(uN, vN) =
            int2d(ThN)( aEps(ukN, pFixe, epsFixe) * gradDot(uN, vN) )
          + int2d(ThN)( bEps(ukN, pFixe, epsFixe) * gradDot(ukN, uN) * gradDot(ukN, vN) )
          - int2d(ThN)( f * vN )
          - int2d(ThN)( bEps(ukN, pFixe, epsFixe) * gradSq(ukN) * gradDot(ukN, vN) )
          + on(1, 2, 3, 4, uN = 0);

        if (sqrt(int2d(ThN)( (uN - ukN)^2 )) < tol) break;
        ukN = uN;
    }
    cout << NActuel << " \t| " << iter << " \t\t| " << uN[].max << endl;
}