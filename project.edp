load "medit"

// Values for the problem
real eps = 1e-6; 
int n = 50;      

// Domain Omega =  [0,1]^2
mesh Th = square(n, n);
fespace Vh(Th, P1); 
Vh u, v, f;

// PART 1
Vh uEx = sin(pi*x)*sin(pi*y); 
Vh f1 = 2*pi^2*sin(pi*x)*sin(pi*y); 

// -Delta u = f
solve Poisson(u, v) = 
    int2d(Th)(dx(u)*dx(v) + dy(u)*dy(v)) 
    - int2d(Th)(f1*v) 
    + on(1, 2, 3, 4, u=0);

// Errors
real errL2 = sqrt(int2d(Th)((u - uEx)^2));
real errH1 = sqrt(int2d(Th)((u - uEx)^2 + (dx(u) - dx(uEx))^2 + (dy(u) - dy(uEx))^2));

cout << "Erreur L2 (p=2) : " << errL2 << endl;
cout << "Erreur H1 (p=2) : " << errH1 << endl;
plot(u, value=true, fill=true, dim=3, wait=true, cmm="Solution for p=2");

// --- ETUDE DE CONVERGENCE EN h (QUESTION 5) ---
// On raffine le maillage et on calcule les erreurs L2 et H1
int[int] nList = [10, 20, 40, 80]; 

cout << "---------------- Convergence en h (p=2) ----------------" << endl;
cout << "n\t h\t\t errL2\t\t errH1\t\t ordreL2\t ordreH1" << endl;

real prevH = -1.0;
real prevErrL2 = -1.0;
real prevErrH1 = -1.0;

for (int k = 0; k < nList.n; k++) 
{
    int nConv = nList[k];
    real h = 1.0 / nConv; // approx pour square(n,n)

    mesh ThConv = square(nConv, nConv);
    fespace VhConv(ThConv, P1);
    VhConv uConv, vConv;

    VhConv uExConv = sin(pi*x)*sin(pi*y);
    VhConv f1Conv = 2*pi^2*sin(pi*x)*sin(pi*y);

    // -Delta u = f
    solve PoissonConv(uConv, vConv) = 
        int2d(ThConv)(dx(uConv)*dx(vConv) + dy(uConv)*dy(vConv)) 
        - int2d(ThConv)(f1Conv*vConv) 
        + on(1, 2, 3, 4, uConv=0);

    // Errors
    real errL2Conv = sqrt(int2d(ThConv)((uConv - uExConv)^2));
    real errH1Conv = sqrt(int2d(ThConv)((uConv - uExConv)^2 
                    + (dx(uConv) - dx(uExConv))^2 
                    + (dy(uConv) - dy(uExConv))^2));

    // Ordres (si possible)
    real ordreL2 = -1.0;
    real ordreH1 = -1.0;

    if (k > 0) 
    {
        ordreL2 = log(prevErrL2/errL2Conv) / log(prevH/h);
        ordreH1 = log(prevErrH1/errH1Conv) / log(prevH/h);
    }

    cout << nConv << "\t " << h << "\t " << errL2Conv << "\t " << errH1Conv;
    if (k > 0) 
        cout << "\t " << ordreL2 << "\t " << ordreH1;
    else 
        cout << "\t " << "-" << "\t " << "-";
    cout << endl;

    prevH = h;
    prevErrL2 = errL2Conv;
    prevErrH1 = errH1Conv;
}

// --- CONFIGURATION PARTIE 2 ---
// On fixe f = 1
f = 1.0; 

real epsReg = 1e-6; // Paramètre de régularisation epsilon 
int maxIter = 200;
real tol = 1e-6;

// Valeurs de p à tester : 2, 3, 5, 10s
real[int] pList = [2.0, 3.0, 5.0, 10.0];

for (int ip = 0; ip < pList.n; ip++) 
{
    real pVal = pList[ip];
    cout << "---------------- Picard : p = " << pVal << " ----------------" << endl;

    Vh uold = 0; // u à l'itération k
    u = 0;

    // --- ALGORITHME DE PICARD ---
    // Résolution itérative
    for (int i = 0; i < maxIter; i++) {
        // Définition du coefficient non linéaire a(u^k)
        // a(u^k) = (epsilon + |grad(u^k)|^2)^((p-2)/2)
        Vh a = (epsReg + dx(uold)^2 + dy(uold)^2)^((pVal - 2.0) / 2.0);

        solve StepPicard(u, v) =
            int2d(Th)(a * (dx(u)*dx(v) + dy(u)*dy(v))) // Terme de diffusion
            - int2d(Th)(f * v)                         // Terme source
            + on(1, 2, 3, 4, u = 0);                   // Dirichlet

        // Vérification de la convergence
        real error = sqrt(int2d(Th)((u - uold)^2));
        uold = u;

        if (error < tol) {
            cout << "Convergence p=" << pVal << " atteinte en " << i << " iterations." << endl;        
            break;
        }

        if (i == maxIter-1) {
            cout << "Attention : pas de convergence pour p=" << pVal << " en " << maxIter << " iterations." << endl;
        }
    }

    // --- VISUALISATION (COULEURS & 3D) ---
    // 1. La solution u (L'élévation)
    plot(u,
        fill=true,
        dim=3,
        cmm="Solution u pour p = " + pVal,
        wait=true);

    // 2. La norme du gradient |grad u|
    Vh gradAbs = sqrt(dx(u)^2 + dy(u)^2);
    plot(gradAbs,
        fill=true,
        dim=3,
        ColorScheme=4, // Palette Viridis (Bleu/Vert/Jaune)
        cmm="Norme du gradient pour p = " + pVal, 
        wait=true);
}